PORT=3000

# Required runtime secrets. Generate with a password manager or:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace_with_a_long_random_unique_secret
META_APP_SECRET=replace_with_meta_app_secret

# Supabase Cloud PostgreSQL Database Configuration
# Pooled connection (Transaction mode - for API requests)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (Session mode - for schema migrations)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_only_service_role_key
SUPABASE_MEDIA_BUCKET=whatsapp-media

# Meta WhatsApp Cloud API Webhook Configuration
META_VERIFY_TOKEN=replace_with_a_random_webhook_verify_token
META_ACCESS_TOKEN=your_meta_system_user_access_token_here
META_PHONE_NUMBER_ID=1358157244046701

# Multi-Company Meta Phone Number IDs
# Royal Wellness Center (RWC) — +94 70 639 3353
META_PHONE_NUMBER_ID_RWC=1358157244046701
# College of Royal Aesthetic of Sri Lanka (CRAS) — +94 70 637 3353
META_PHONE_NUMBER_ID_CRAS=1378201582041705

# Frontend Application URL (for CORS)
FRONTEND_URL=http://localhost:5173
TRUST_PROXY=false
INITIAL_ADMIN_SETUP_TOKEN=replace_with_a_one_time_bootstrap_token

