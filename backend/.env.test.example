# Isolated test database configuration.
#
# Copy to `backend/.env.test` and point TEST_DATABASE_URL at a THROWAWAY database.
# Never commit `backend/.env.test` — it is gitignored.
#
# How the guard works (backend/src/testDbGuard.js):
#   * When NODE_ENV=test, `.env.test` is loaded and OVERRIDES `backend/.env`.
#   * If TEST_DATABASE_URL is set, it becomes DATABASE_URL for the test run.
#   * If TEST_DATABASE_URL is absent, DATABASE_URL must itself look like a test target
#     (host localhost/127.0.0.1, or the database name containing `_test`).
#   * Anything else refuses to run, so a misconfigured runner can never mutate
#     production business records.
#
# Recommended: a free Supabase project, or a local Postgres:
#   docker run --name crm-test-db -e POSTGRES_PASSWORD=postgres -p 5433:5432 -d postgres:16
#   createdb -h localhost -p 5433 crm_test
# Then:

DB_ENVIRONMENT=test
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/crm_test"

# The app requires a JWT secret even in test; a fixed value keeps tokens reproducible.
JWT_SECRET=test-only-jwt-secret-do-not-use

# Meta webhook secret used by signature tests. Any value works outside production.
META_APP_SECRET=test-meta-app-secret

# Leave proxy trust OFF for tests so X-Forwarded-For is never honoured.
TRUST_PROXY=false
