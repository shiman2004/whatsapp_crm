{
  "name": "royal-wellness-crm-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node scripts/run-tests.js",
    "test:setup": "node scripts/setup-test-db.js",
    "test:phonetic": "npx tsx test-phonetic-composer.js",
    "bench:leads:seed": "node scripts/seed-bench-data.mjs 2000",
    "bench:leads:clear": "node scripts/seed-bench-data.mjs --clear",
    "bench:leads": "node scripts/bench-leads.mjs",
    "build": "prisma generate",
    "postinstall": "prisma generate",
    "webhook": "node webhook-standalone.js",
    "media:migrate-private": "node scripts/migrate-media-private.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "node scripts/run-prisma-operation.js push",
    "prisma:migrate": "node scripts/run-prisma-operation.js migrate-dev",
    "prisma:migrate:deploy": "node scripts/run-prisma-operation.js migrate-deploy",
    "prisma:studio": "prisma studio",
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@supabase/supabase-js": "^2.49.1",
    "dotenv": "^16.4.7",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "prisma": "^7.10.1"
  }
}
