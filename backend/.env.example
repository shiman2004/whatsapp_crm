# ==============================================================================
# Royal Wellness WhatsApp CRM — Backend Environment Variables
# ==============================================================================

# Server Port
PORT=3001

# MySQL Database Connection String (Prisma format)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME?charset=utf8mb4
DATABASE_URL="mysql://root:password@localhost:3306/royal_wellness_crm"

# Meta WhatsApp Cloud API (Optional - for Cloud API integration)
META_VERIFY_TOKEN=royal_wellness_token_2026
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=

# Frontend Application Origin (CORS)
FRONTEND_URL=http://localhost:5173
